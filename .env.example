# TENIR-Gov 5.2.0 local development secrets
# Replace every placeholder before starting the services.
TENIR_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
TENIR_OPERATOR_ID=operator-1
OATH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional runtime settings
TENIR_MODE=SHADOW_PASSIVE
TENIR_POLICY_PROFILE=default
TENIR_CORS_ORIGINS=http://localhost:8000
TENIR_HOST_PORT=8000

# Required when enabling the optional Neo4j graph profile
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-random-password-at-least-8-characters
NEO4J_DATABASE=tenir
